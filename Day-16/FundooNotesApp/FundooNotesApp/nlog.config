<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration for FundooNotesApp — Day-16.
  Targets: Console (colored) + Rolling File (daily, keep 7 days).
  Layout: Timestamp | Level | Logger | Message | Exception.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <targets>
    <!-- Colored console output -->
    <target xsi:type="ColoredConsole"
            name="console"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss} | ${uppercase:${level},-5} | ${logger:shortName=true} | ${message} ${exception:format=Message}" >
      <highlight-row condition="level == LogLevel.Debug"   foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Info"    foregroundColor="Cyan" />
      <highlight-row condition="level == LogLevel.Warn"    foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error"   foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal"   foregroundColor="Red" backgroundColor="White" />
    </target>

    <!-- Daily rolling file: logs/fundoo-2026-08-21.log -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/fundoo-${shortdate}.log"
            layout="${longdate} | ${uppercase:${level},-5} | ${logger} | ${message} ${exception:format=tostring}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveDays="7"
            concurrentWrites="true"
            keepFileOpen="false" />
  </targets>

  <rules>
    <!-- Allow the specific logger that prints the "Now listening on: http://..." message -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" />
    
    <!-- Skip noisy EF Core SQL command logs in file; keep them in console only at Debug -->
    <logger name="Microsoft.EntityFrameworkCore.Database.Command" minlevel="Info" writeTo="console" final="true" />
    
    <!-- Skip all other Microsoft / System noise below Warn -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    
    <!-- App logs: Info+ to both targets -->
    <logger name="*" minlevel="Information" writeTo="console,file" />
  </rules>
</nlog>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss} | ${uppercase:${level},-5} | ${logger:shortName=true} | ${message} ${exception:format=Message}"
      },
      "file": {
        "type": "File",
        "fileName": "${basedir}/logs/fundoo-${shortdate}.log",
        "layout": "${longdate} | ${uppercase:${level},-5} | ${logger} | ${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      { "logger": "Microsoft.Hosting.Lifetime", "minlevel": "Info", "writeTo": "console,file" },
      { "logger": "Microsoft.*",       "maxlevel": "Info", "final": true },
      { "logger": "*",                 "minlevel": "Information", "writeTo": "console,file" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=FundooNotesDb_Day16;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "FundooNotes_Day16_JWT_SecretKey_Must_Be_At_Least_32_Characters!!",
    "Issuer": "FundooNotesApp",
    "Audience": "FundooNotesUsers",
    "ExpiryMinutes": "60"
  },
  "CorsOrigins": [
    "http://localhost:3000",
    "http://localhost:4200",
    "http://localhost:5173",
    "http://localhost:8080"
  ]
}

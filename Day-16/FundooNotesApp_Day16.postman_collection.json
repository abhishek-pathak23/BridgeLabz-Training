{
  "info": {
    "_postman_id": "fundoo-day16-labels",
    "name": "FundooNotesApp — Day 16 (Labels + NLog + MSTest)",
    "description": "Complete Postman collection for FundooNotesApp Day-16.\n\nFeatures covered:\n- Auth (Register, Login, Forgot/Reset Password)\n- Notes CRUD + Pin/Archive/Trash/Search\n- Labels CRUD + Note Assignment\n\nWorkflow:\n1. Run 'Login' to get JWT token → auto-saved to {{jwt_token}} variable\n2. All other requests use {{jwt_token}} automatically\n\nBase URL: {{base_url}} — default: http://localhost:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",   "value": "http://localhost:5000",  "type": "string" },
    { "key": "jwt_token",  "value": "",                       "type": "string" },
    { "key": "note_id",    "value": "1",                      "type": "string" },
    { "key": "label_id",   "value": "1",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔑 Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Abhishek\",\n  \"lastName\": \"Pathak\",\n  \"email\": \"abhishek@example.com\",\n  \"password\": \"Test@1234\",\n  \"role\": \"User\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "    console.log('✅ JWT token saved to collection variable jwt_token');",
                  "} else {",
                  "    console.log('❌ No token in response');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abhishek@example.com\",\n  \"password\": \"Test@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('jwt_token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundoo.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abhishek@example.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/forgot-password", "host": ["{{base_url}}"], "path": ["api", "auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abhishek@example.com\",\n  \"token\": \"PASTE_RESET_TOKEN_HERE\",\n  \"newPassword\": \"NewPass@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/reset-password", "host": ["{{base_url}}"], "path": ["api", "auth", "reset-password"] }
          }
        },
        {
          "name": "JWT Debug (decode claims)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/auth/debug", "host": ["{{base_url}}"], "path": ["api", "auth", "debug"] }
          }
        }
      ]
    },
    {
      "name": "📝 Notes",
      "item": [
        {
          "name": "Create Note",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.note && json.note.id) {",
                  "    pm.collectionVariables.set('note_id', json.note.id.toString());",
                  "    console.log('✅ note_id saved:', json.note.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Note\",\n  \"description\": \"This is a test note created via Postman.\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/notes", "host": ["{{base_url}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Get All Notes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/notes", "host": ["{{base_url}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Get Note By Id",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}"] }
          }
        },
        {
          "name": "Update Note",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Note Title\",\n  \"description\": \"Updated description.\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}"] }
          }
        },
        {
          "name": "Toggle Pin",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}/pin", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}", "pin"] }
          }
        },
        {
          "name": "Toggle Archive",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}/archive", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}", "archive"] }
          }
        },
        {
          "name": "Toggle Trash",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}/trash", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}", "trash"] }
          }
        },
        {
          "name": "Search Notes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/notes/search?q=note",
              "host": ["{{base_url}}"],
              "path": ["api", "notes", "search"],
              "query": [{ "key": "q", "value": "note" }]
            }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}"] }
          }
        }
      ]
    },
    {
      "name": "🏷️ Labels (Day-16 New)",
      "item": [
        {
          "name": "Create Label",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.label && json.label.id) {",
                  "    pm.collectionVariables.set('label_id', json.label.id.toString());",
                  "    console.log('✅ label_id saved:', json.label.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Work\",\n  \"color\": \"#FF5733\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/labels", "host": ["{{base_url}}"], "path": ["api", "labels"] }
          }
        },
        {
          "name": "Create Label — Personal",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal\",\n  \"color\": \"#3498DB\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/labels", "host": ["{{base_url}}"], "path": ["api", "labels"] }
          }
        },
        {
          "name": "Get All Labels",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/labels", "host": ["{{base_url}}"], "path": ["api", "labels"] }
          }
        },
        {
          "name": "Get Label By Id",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/labels/{{label_id}}", "host": ["{{base_url}}"], "path": ["api", "labels", "{{label_id}}"] }
          }
        },
        {
          "name": "Update Label",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Work (Updated)\",\n  \"color\": \"#E74C3C\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/labels/{{label_id}}", "host": ["{{base_url}}"], "path": ["api", "labels", "{{label_id}}"] }
          }
        },
        {
          "name": "Assign Label to Note",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/labels/{{label_id}}/notes/{{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "labels", "{{label_id}}", "notes", "{{note_id}}"]
            }
          }
        },
        {
          "name": "Get Notes by Label",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/labels/{{label_id}}/notes",
              "host": ["{{base_url}}"],
              "path": ["api", "labels", "{{label_id}}", "notes"]
            }
          }
        },
        {
          "name": "Remove Label from Note",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/labels/{{label_id}}/notes/{{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "labels", "{{label_id}}", "notes", "{{note_id}}"]
            }
          }
        },
        {
          "name": "Delete Label",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/labels/{{label_id}}", "host": ["{{base_url}}"], "path": ["api", "labels", "{{label_id}}"] }
          }
        }
      ]
    },
    {
      "name": "👤 User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/user/profile", "host": ["{{base_url}}"], "path": ["api", "user", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Abhishek\",\n  \"lastName\": \"Pathak Updated\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/user/profile", "host": ["{{base_url}}"], "path": ["api", "user", "profile"] }
          }
        }
      ]
    }
  ]
}

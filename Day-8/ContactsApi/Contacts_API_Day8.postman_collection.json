	"item": [
		{
			"name": "GET All Contacts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is a JSON array', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5000/api/contacts",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "contacts"]
				}
			}
		},
		{
			"name": "GET Contact By ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has contact fields', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('firstName');",
							"    pm.expect(jsonData).to.have.property('email');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5000/api/contacts/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "contacts", "1"]
				}
			}
		},
		{
			"name": "POST Create Contact",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Response contains created contact', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.firstName).to.eql('Vikram');",
							"    pm.expect(jsonData.lastName).to.eql('Singh');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"firstName\": \"Vikram\",\n  \"lastName\": \"Singh\",\n  \"email\": \"vikram.singh@example.com\",\n  \"phoneNumber\": \"+91-9871234567\",\n  \"category\": \"Work\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/contacts",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "contacts"]
				}
			}
